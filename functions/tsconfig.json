{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    // node10 해석이 낡았다고 나오지만, Cloud Functions가 CommonJS로 돌아간다.
    // 바꾸면 shared/ 를 그대로 못 읽는다 — TypeScript 7로 올릴 때 같이 본다.
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],
    "outDir": "lib",
    // 규칙 코드(shared/)를 화면과 서버가 같이 쓴다. 공통 조상을 rootDir로
    // 잡아야 lib 밑에 functions/src 와 shared 가 나란히 떨어진다.
    "rootDir": "..",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"],
  "exclude": ["../shared/**/*.test.ts"]
}
