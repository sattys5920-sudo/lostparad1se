rules_version = '2';

// 친구들끼리 하는 비공개 게임용 규칙 — 별도 서버 인증 없이 앱 접근 코드(가입 코드)와
// 자체 아이디/비밀번호(해시 저장)로만 구분하므로, 세부 권한 대신 sessions/live 트리
// 바깥은 전부 차단하는 정도로 스코프를 좁힌다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/live {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /feedPosts/{postId} {
        allow read, write: if true;
      }

      match /accounts/{username} {
        allow read, write: if true;
      }
    }

    match /schoolSessions/live {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /dmThreads/{threadKey} {
        allow read, write: if true;
      }

      // 계정. 비밀번호는 소금을 섞은 해시로만 올라오고 원문은 오지 않는다.
      // 목록은 막고 한 건 읽기만 연다 — 아이디를 모르면 남의 계정을 못 찾는다.
      // 이미 있는 아이디를 덮어쓰는 것도 막는다.
      match /accounts/{accountId} {
        allow get: if true;
        allow list: if false;
        allow create: if true;
        // 닉네임과 아바타만 갈아 끼울 수 있다. 비밀번호 칸은 못 건드린다.
        allow update: if !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['salt', 'hash', 'createdAtMs']);
        allow delete: if false;
      }

      // 지도: 살아 있는 좌표, 방 출입 구간, 목격이 붙은 사건, 익명 쪽지
      match /positions/{playerId} {
        allow read, write: if true;
      }

      match /intervals/{intervalId} {
        allow read, write: if true;
      }

      match /spatialEvents/{eventId} {
        allow read, write: if true;
      }

      match /notes/{noteId} {
        allow read, write: if true;
      }
    }

    // 걸어 다니는 학교 프로토타입. 본 게임 트리와 완전히 분리해 둔다.
    match /protoRoom/{roomId} {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
