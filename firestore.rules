rules_version = '2';

// 친구들끼리 하는 비공개 게임용 규칙 — 별도 서버 인증 없이 앱 접근 코드(가입 코드)와
// 자체 아이디/비밀번호(해시 저장)로만 구분하므로, 세부 권한 대신 sessions/live 트리
// 바깥은 전부 차단하는 정도로 스코프를 좁힌다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/live {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /feedPosts/{postId} {
        allow read, write: if true;
      }

      match /accounts/{username} {
        allow read, write: if true;
      }
    }

    match /schoolSessions/live {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /dmThreads/{threadKey} {
        allow read, write: if true;
      }

      // 계정. 비밀번호 원문은 오지 않고, 소금을 섞은 해시만 올라온다.
      //
      // 해시는 계정 문서가 아니라 그 아래 auth/secret에 둔다. 그래서 계정
      // 목록을 펴 봐도(진행자가 정리하려면 필요하다) 해시는 딸려 나오지
      // 않는다. 해시 문서는 목록 보기를 막아 아이디를 정확히 아는 사람만
      // 한 건씩 읽을 수 있다.
      match /accounts/{accountId} {
        // 닉네임·아바타뿐이라 열어 둔다. 진행자 화면이 이걸로 목록을 만든다
        allow get, list: if true;
        allow create: if true;
        // 계정 문서에 해시를 도로 심지 못하게 막는다. 고치고 난 문서에 해시가
        // 남아 있으면 안 된다 — 걷어내는 것(예전 계정 옮기기)은 통과한다
        allow update: if !request.resource.data.keys().hasAny(['salt', 'hash']);
        // 진행자가 가입 데이터를 지운다
        allow delete: if true;

        // 소금과 해시. **서버만 읽고 쓴다.**
        //
        // 전에는 한 건 읽기를 열어 두었다. 브라우저가 해시를 비교했기
        // 때문인데, 그 말은 개발자도구로 비교를 건너뛸 수 있었다는 뜻이다.
        // 검사를 서버로 옮겼으니 이 문서도 닫는다 — Admin SDK는 규칙을
        // 거치지 않으므로 서버는 그대로 읽는다.
        match /auth/{docId} {
          allow read, write: if false;
        }
      }

      // 지도: 살아 있는 좌표, 방 출입 구간, 목격이 붙은 사건, 익명 쪽지
      match /positions/{playerId} {
        allow read, write: if true;
      }

      match /intervals/{intervalId} {
        allow read, write: if true;
      }

      match /spatialEvents/{eventId} {
        allow read, write: if true;
      }

      match /notes/{noteId} {
        allow read, write: if true;
      }
    }

    // ── 영역전 v2 ────────────────────────────────────────────────
    //
    // 판정은 전부 Cloud Functions가 한다. Admin SDK는 규칙을 거치지 않으므로
    // 여기서는 클라이언트에게 "쓰기 전면 금지, 읽기는 봐도 되는 것만"으로
    // 잠근다.
    //
    // 숨겨야 하는 것은 받은 뒤 화면에서 숨기지 않는다. 애초에 읽을 수 있는
    // 자리에 두지 않는다.
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow write: if false;

      // 숨길 것이 없는 것들 — 주인, 깃발, 자원, 순위, 기록
      match /tiles/{tileId}      { allow read: if request.auth != null; allow write: if false; }
      match /flags/{tileId}      { allow read: if request.auth != null; allow write: if false; }
      match /teams/{teamId}      { allow read: if request.auth != null; allow write: if false; }
      match /sabotages/{id}      { allow read: if request.auth != null; allow write: if false; }
      match /events/{eventId}    { allow read: if request.auth != null; allow write: if false; }

      // 말의 위치는 안개 때문에 통째로 막는다. 각자 views로만 본다.
      match /pawns/{playerId}    { allow read, write: if false; }

      // 따라잡기용 내부 자료. 예정된 일을 미리 보면 작전이 새어 나간다.
      match /schedule/{id}       { allow read, write: if false; }

      // 서버만. 익명 표의 보낸 사람, 손패 내용, 비밀 목표, 등교 예약,
      // 가짜 깃발 여부, 약점, 역할과 개인 미션이 전부 이 아래 있다.
      match /secret/{document=**} { allow read, write: if false; }

      // 서버가 그 사람 몫으로 깎아 둔 것. 본인만 읽는다.
      match /views/{playerId} {
        allow read: if request.auth != null && request.auth.uid == playerId;
        allow write: if false;
      }

      // 추리 노트. 본인만 읽고 본인만 쓴다.
      //
      // 다른 문서와 달리 클라이언트가 직접 쓴다. 판정에 쓰이지 않는
      // 개인 메모라 서버가 검사할 것이 없고, 서버를 거치게 하면 혼자
      // 끄적이는 자리가 느려질 뿐이다.
      //
      // 운영자도 읽지 못한다. 대시보드에 남의 추리가 뜨는 순간
      // 이 노트는 혼자 생각하는 자리가 아니게 된다. 그래서 여기에는
      // 운영자 예외를 두지 않는다.
      match /notes/{playerId} {
        allow read, write: if request.auth != null && request.auth.uid == playerId;
      }

      // 역할을 내려놓은 사람. 자기 것만 만들 수 있고 되돌릴 수 없다.
      match /retired/{playerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == playerId;
        allow update, delete: if false;
      }

      // 회고 게시판.
      //
      // 역할을 내려놓은 사람만 쓴다. 아직 역할 안에 있는 사람이 끼면
      // 그 한 줄이 연기인지 아닌지 읽는 쪽이 알 수 없다.
      //
      // 익명 글에는 authorId를 **담지 못하게 막는다.** 담아 두고 화면에서
      // 이름만 가리는 방식이면 문서를 직접 읽는 순간 누군지 보인다.
      match /retro/{postId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/games/$(gameId)/retired/$(request.auth.uid))
          && (
            request.resource.data.anonymous == true
              ? !request.resource.data.keys().hasAny(['authorId'])
              : request.resource.data.authorId == request.auth.uid
          );
        // 남긴 말은 고치지도 지우지도 않는다
        allow update, delete: if false;
      }
    }

    // 걸어 다니는 학교 프로토타입. 본 게임 트리와 완전히 분리해 둔다.
    match /protoRoom/{roomId} {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
