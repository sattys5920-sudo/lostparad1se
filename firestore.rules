rules_version = '2';

// 친구들끼리 하는 비공개 게임용 규칙 — 별도 서버 인증 없이 앱 접근 코드(가입 코드)와
// 자체 아이디/비밀번호(해시 저장)로만 구분하므로, 세부 권한 대신 sessions/live 트리
// 바깥은 전부 차단하는 정도로 스코프를 좁힌다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/live {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /feedPosts/{postId} {
        allow read, write: if true;
      }

      match /accounts/{username} {
        allow read, write: if true;
      }
    }

    match /schoolSessions/live {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /dmThreads/{threadKey} {
        allow read, write: if true;
      }

      // 계정. 비밀번호 원문은 오지 않고, 소금을 섞은 해시만 올라온다.
      //
      // 해시는 계정 문서가 아니라 그 아래 auth/secret에 둔다. 두 겹으로
      // 막아 둔 셈이다 — 계정 문서를 읽어도 해시는 딸려 나오지 않고,
      // 해시 문서는 서버 말고 아무도 못 읽는다.
      match /accounts/{accountId} {
        // **제 것만 읽는다.**
        //
        // 전에는 목록 보기까지 열어 두었다. 진행자 화면이 브라우저에서
        // 계정 컬렉션을 통째로 읽었기 때문인데, 그 말은 가입한 사람들의
        // 아이디와 이름이 누구에게나 보였다는 뜻이다 — 화면 하나 만들자고
        // 명부를 길에 내놓은 꼴이었다. 목록도 지우기도 서버로 옮겼다
        // (hostAccounts · hostDeleteAccounts, 운영자 표시를 서버가 본다).
        //
        // 가입·수정·삭제는 전부 서버가 한다. Admin SDK 는 규칙을 안 거친다.
        allow get: if request.auth != null && request.auth.token.accountId == accountId;
        allow list, create, update, delete: if false;

        // 소금과 해시. **서버만 읽고 쓴다.**
        //
        // 전에는 한 건 읽기를 열어 두었다. 브라우저가 해시를 비교했기
        // 때문인데, 그 말은 개발자도구로 비교를 건너뛸 수 있었다는 뜻이다.
        // 검사를 서버로 옮겼으니 이 문서도 닫는다 — Admin SDK는 규칙을
        // 거치지 않으므로 서버는 그대로 읽는다.
        match /auth/{docId} {
          allow read, write: if false;
        }
      }

      // 지도: 살아 있는 좌표, 방 출입 구간, 목격이 붙은 사건, 익명 쪽지
      match /positions/{playerId} {
        allow read, write: if true;
      }

      match /intervals/{intervalId} {
        allow read, write: if true;
      }

      match /spatialEvents/{eventId} {
        allow read, write: if true;
      }

      match /notes/{noteId} {
        allow read, write: if true;
      }
    }

    // ── 영역전 v2 ────────────────────────────────────────────────
    //
    // 판정은 전부 Cloud Functions가 한다. Admin SDK는 규칙을 거치지 않으므로
    // 여기서는 클라이언트에게 "쓰기 전면 금지, 읽기는 봐도 되는 것만"으로
    // 잠근다.
    //
    // 숨겨야 하는 것은 받은 뒤 화면에서 숨기지 않는다. 애초에 읽을 수 있는
    // 자리에 두지 않는다.
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow write: if false;

      // 숨길 것이 없는 것들 — 주인, 깃발, 순위, 기록
      match /tiles/{tileId}      { allow read: if request.auth != null; allow write: if false; }
      match /events/{eventId}    { allow read: if request.auth != null; allow write: if false; }

      // 팀 문서. **우리 팀 것만 읽는다.**
      //
      // 금고(돈·지식)가 여기 있다. 전에는 누구나 네 팀 것을 다 읽을 수
      // 있어서 「저 팀 지식이 4니까 곧 로봇이 나온다」가 추측이 아니라
      // 계산이었다. 오늘의 주장이 누구인지도 여기 적혀 있는데, 그것도
      // 우리 팀만 알아야 하는 것이다 — 3인 팀 둘이 같은 방에 섰을 때
      // 누가 두 명 몫인지 모르는 것이 방해를 도박으로 만든다.
      //
      // 소속은 pawns 로 확인한다. 규칙의 get()은 클라이언트 규칙을
      // 거치지 않으므로, 말 문서가 닫혀 있어도 여기서는 읽힌다.
      //
      // 말이 있는지 먼저 본다. 시작 전에는 말이 없어서, 바로 get() 하면
      // 규칙이 「거절」이 아니라 「터짐」으로 답한다 — 터진 규칙은
      // 화면 전체를 오류 창으로 바꾼다. 없으면 조용히 아니라고 한다.
      match /teams/{teamId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/games/$(gameId)/pawns/$(request.auth.uid))
          && get(/databases/$(database)/documents/games/$(gameId)/pawns/$(request.auth.uid)).data.team == teamId;
        allow write: if false;
      }

      // 페이즈가 끝날 때마다 무슨 일이 있었는지. 모두 같은 것을 본다 —
      // 점령전의 결과는 숨길 것이 아니라 다음 페이즈를 위한 재료다.
      match /phaseLog/{no}       { allow read: if request.auth != null; allow write: if false; }

      // 말과 로봇의 위치는 안개 때문에 통째로 막는다. 각자 views로만 본다.
      match /pawns/{playerId}    { allow read, write: if false; }
      match /robots/{robotId}    { allow read, write: if false; }

      // 따라잡기용 내부 자료. 예정된 일을 미리 보면 작전이 새어 나간다.
      match /schedule/{id}       { allow read, write: if false; }

      // 서버만. 익명 표의 보낸 사람, 손패 내용, 비밀 목표, 등교 예약,
      // 가짜 깃발 여부, 약점, 역할과 개인 미션이 전부 이 아래 있다.
      //
      // 판정에 쓰이는 다섯 기록(secret/records, secret/intervals)과
      // 문제 은행(secret/quiz)도 여기 있다. 기록을 통째로 읽을 수 있으면
      // 남이 무엇을 하려는지 역산된다 — 판정은 서버가 하고, 각자에게는
      // 자기 진행도만 views 로 간다.
      match /secret/{document=**} { allow read, write: if false; }

      // 거래판. **마주 앉은 둘만 읽는다.**
      //
      // 흥정이 실시간이라 views 를 거치면 반 박자가 늦는다 — 상대가
      // 물건을 올리는 것이 보여야 흥정이다. 그래서 문서를 직접 열되,
      // 그 거래의 두 사람에게만 연다. 쪽지는 **장수만** 여기 적고
      // 어느 쪽지인지는 secret 에 둔다 — 접힌 채로 건네는 것이 쪽지다.
      match /deals/{dealId} {
        allow read: if request.auth != null
          && (request.auth.uid == resource.data.aId || request.auth.uid == resource.data.bId);
        allow write: if false;
      }

      // 서버가 그 사람 몫으로 깎아 둔 것. 본인만 읽는다.
      match /views/{playerId} {
        allow read: if request.auth != null && request.auth.uid == playerId;
        allow write: if false;
      }

      // 지금 어디서 어디를 보고 있는가. **화면이 직접 적는다.**
      //
      // views 를 거치면 걸음이 뚝뚝 끊긴다 — 서버는 멈춰 선 자리만
      // 알고, 그것도 열넷 몫을 한꺼번에 다시 쓴다. 걷는 모습이 보이려면
      // 초에 몇 번씩 오가야 하는데 그 값을 서버가 치를 이유가 없다.
      //
      // **누가 읽어도 되는지는 여전히 서버가 정한다.** 그 사람의 view 에
      // 든 사람만 그 사람의 live 를 연다 — 안개가 가린 사람, 잠복한
      // 사람, 지워진 사람은 애초에 목록에 없으므로 여기서도 안 열린다.
      // 화면이 받아서 숨기는 것이 아니라 오지를 않는다.
      //
      // 적는 것은 본인만. 남의 자리에 남의 이름으로 설 수는 없다.
      // 제 자리를 거짓으로 적는 것은 막지 않는다 — 판정은 전부 pawns 를
      // 보므로, 거짓말은 남의 화면에서 헛걸음을 시킬 뿐이다.
      match /live/{playerId} {
        // **시작 전에는 안개가 없다.**
        //
        // 말이 아직 없어서 view 도 없다. 그 말은 「누가 보이는가」를
        // 서버가 가려 줄 것이 없다는 뜻이고, 가릴 것도 없다는 뜻이다 —
        // 아직 아무에게도 역할도 자리도 비밀도 없다. 열넷이 차기를
        // 기다리는 동안 서로가 안 보이면, 같은 교실에 둘이 서 있어도
        // 각자 빈 학교를 걷는다.
        //
        // 시작한 뒤에는 그 사람의 view 에 든 사람만 연다. 안개가 가린
        // 사람, 잠복한 사람, 지워진 사람은 애초에 목록에 없다.
        allow read: if request.auth != null && (
          (exists(/databases/$(database)/documents/games/$(gameId))
            && get(/databases/$(database)/documents/games/$(gameId)).data.startedAtMs == null)
          || (exists(/databases/$(database)/documents/games/$(gameId)/views/$(request.auth.uid))
            && get(/databases/$(database)/documents/games/$(gameId)/views/$(request.auth.uid))
                 .data.visibleIds.hasAny([playerId]))
        );
        allow write: if request.auth != null && request.auth.uid == playerId;
      }

      // 추리 노트. 본인만 읽고 본인만 쓴다.
      //
      // 다른 문서와 달리 클라이언트가 직접 쓴다. 판정에 쓰이지 않는
      // 개인 메모라 서버가 검사할 것이 없고, 서버를 거치게 하면 혼자
      // 끄적이는 자리가 느려질 뿐이다.
      //
      // 운영자도 읽지 못한다. 대시보드에 남의 추리가 뜨는 순간
      // 이 노트는 혼자 생각하는 자리가 아니게 된다. 그래서 여기에는
      // 운영자 예외를 두지 않는다.
      match /notes/{playerId} {
        allow read, write: if request.auth != null && request.auth.uid == playerId;
      }

      // 역할을 내려놓은 사람. 자기 것만 만들 수 있고 되돌릴 수 없다.
      match /retired/{playerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == playerId;
        allow update, delete: if false;
      }

      // 회고 게시판.
      //
      // 역할을 내려놓은 사람만 쓴다. 아직 역할 안에 있는 사람이 끼면
      // 그 한 줄이 연기인지 아닌지 읽는 쪽이 알 수 없다.
      //
      // 익명 글에는 authorId를 **담지 못하게 막는다.** 담아 두고 화면에서
      // 이름만 가리는 방식이면 문서를 직접 읽는 순간 누군지 보인다.
      match /retro/{postId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/games/$(gameId)/retired/$(request.auth.uid))
          && (
            request.resource.data.anonymous == true
              ? !request.resource.data.keys().hasAny(['authorId'])
              : request.resource.data.authorId == request.auth.uid
          );
        // 남긴 말은 고치지도 지우지도 않는다
        allow update, delete: if false;
      }
    }

    // 걸어 다니는 학교 프로토타입. 본 게임 트리와 완전히 분리해 둔다.
    match /protoRoom/{roomId} {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 운영자 코드를 틀린 횟수. 아래 포괄 규칙으로도 막히지만, 여기
    // 적어 두어야 나중에 이 문서를 찾는 사람이 의도를 안다.
    match /hostGate/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
